# ====================================================================
# NEXT.JS & APP CONFIGURATION
# ====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====================================================================
# SUPABASE
# ====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ====================================================================
# AUTHENTICATION
# ====================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-min-32-chars

# ====================================================================
# BRAINTREE PAYMENT INTEGRATION
# ====================================================================
# Get these from: https://sandbox.braintreegateway.com/merchants/your_merchant_id/credentials
BRAINTREE_MERCHANT_ID=your_merchant_id
BRAINTREE_PUBLIC_KEY=your_public_key
BRAINTREE_PRIVATE_KEY=your_private_key
BRAINTREE_ENVIRONMENT=sandbox
# This is used for frontend Drop-in UI initialization
NEXT_PUBLIC_BRAINTREE_TOKENIZATION_KEY=your_tokenization_key

# ====================================================================
# ANTHROPIC AI
# ====================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ====================================================================
# EMAIL (BREVO)
# ====================================================================
# Get your API key from: https://app.brevo.com/settings/keys/api
# Configure these in Supabase Edge Function secrets
BREVO_API_KEY=xkeysib-xxx
FROM_EMAIL=noreply@yourdomain.com

# ====================================================================
# ADMIN (production cleanup endpoint)
# ====================================================================
# Email of the admin user to preserve during production cleanup
ADMIN_EMAIL=admin@yourdomain.com
# Strong secret (32+ chars) to authenticate the cleanup endpoint
ADMIN_SECRET=your-admin-secret-min-32-chars

# ====================================================================
# SECURITY
# ====================================================================
# Generate a random 32+ character string for ID encoding
ID_SECRET_KEY=your-hmac-secret-for-id-encoding-min-32-chars

# ====================================================================
# CRON JOBS
# ====================================================================
# Secret for authenticating cron job requests
CRON_SECRET=your-cron-secret-min-32-chars

# ====================================================================
# OPTIONAL - DEVELOPMENT & MONITORING
# ====================================================================
# Sentry error tracking
SENTRY_DSN=https://xxx@sentry.io/xxx

# Socket.IO for real-time features
SOCKET_PORT=3001

# Feature flags
FRAUD_PREVENTION_V1=true

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps (used for location autocomplete)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ====================================================================
# BRAINTREE SANDBOX TEST CREDENTIALS
# ====================================================================
# Use these for testing in sandbox mode:
# Test Credit Card: 4111 1111 1111 1111
# Expiry: Any future date
# CVV: Any 3 digits
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Social media URLs (optional)
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourhandle
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/yourcompany
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage

# Supabase edge function secrets (set via: supabase secrets set)
SITE_URL=https://yourdomain.com
SITE_DOMAIN=yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Page-specific contact emails (optional, falls back to NEXT_PUBLIC_SUPPORT_EMAIL)
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.com
NEXT_PUBLIC_LEGAL_EMAIL=legal@yourdomain.com
